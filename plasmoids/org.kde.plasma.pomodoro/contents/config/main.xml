<?xml version="1.0" encoding="UTF-8"?>
<kcfg
    xmlns="http://www.kde.org/standards/kcfg/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0 http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
  <kcfgfile name="" />
  <group name="General">
    <entry name="focusMinutes" type="Int">
      <default>25</default>
    </entry>
    <entry name="shortBreakMinutes" type="Int">
      <default>5</default>
    </entry>
    <entry name="longBreakMinutes" type="Int">
      <default>15</default>
    </entry>
    <entry name="sessionsUntilLongBreak" type="Int">
      <default>4</default>
    </entry>
    <entry name="focusDescription" type="String">
      <default></default>
    </entry>
    <entry name="autoStartBreaks" type="Bool">
      <default>false</default>
    </entry>
    <entry name="autoStartFocus" type="Bool">
      <default>false</default>
    </entry>
    <!-- On by default: the durations are repeated in the popup so the timer can
         be retuned without a trip to the config dialog. Turn it off for the
         compact popup, where the durations live in the config dialog only. -->
    <entry name="showInlineSettings" type="Bool">
      <default>true</default>
    </entry>

    <!-- Runtime state is persisted so a running timer survives a shell restart. -->
    <entry name="currentPhase" type="String">
      <default>focus</default>
    </entry>
    <entry name="timerRunning" type="Bool">
      <default>false</default>
    </entry>
    <entry name="remainingSeconds" type="Int">
      <default>1500</default>
    </entry>
    <entry name="phaseTotalSeconds" type="Int">
      <default>1500</default>
    </entry>
    <entry name="deadlineEpochMs" type="String">
      <default>0</default>
    </entry>
    <entry name="focusesSinceLongBreak" type="Int">
      <default>0</default>
    </entry>
    <entry name="completedFocusSessions" type="Int">
      <default>0</default>
    </entry>
    <entry name="completedFocusSessionsToday" type="Int">
      <default>0</default>
    </entry>
    <entry name="dailyCounterDate" type="String">
      <default></default>
    </entry>
    <!-- JSON array of ["YYYY-MM-DD", count] pairs, oldest first, capped at 90
         entries. A String holding JSON rather than a StringList (KConfig comma
         escaping is fragile) or LocalStorage (plasmashell's offline-storage
         directory is shared process-wide, so two instances of this widget would
         silently merge their histories). Same pragmatism as deadlineEpochMs. -->
    <entry name="dailyHistory" type="String">
      <default></default>
    </entry>
  </group>
</kcfg>
